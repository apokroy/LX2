// clang stack probe for frames larger than a page: rax = frame size; it only touches the
// pages one by one, leaves rsp alone and preserves every register except r10/r11.
procedure ___chkstk_ms;
asm
        lea     r10, [rsp]
        mov     r11, r10
        sub     r11, rax
        and     r11w, 0f000h
        and     r10w, 0f000h
@@loop1:
        sub     r10, 01000h
        cmp     r10, r11
        jl      @@exit
        mov     qword [r10], 0
        jmp     @@loop1
@@exit:
end;
